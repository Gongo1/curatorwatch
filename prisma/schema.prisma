generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vault {
  id              String   @id @default(cuid())
  address         String   @unique
  name            String
  symbol          String
  chainId         Int      @default(1)
  assetAddress    String
  assetSymbol     String
  assetDecimals   Int
  curatorAddress  String?
  curatorId       String?
  curator         Curator? @relation(fields: [curatorId], references: [id])
  performanceFee  Float    @default(0)
  managementFee   Float    @default(0)
  active          Boolean  @default(true)  // For marking inactive vaults

  // Multi-protocol fields
  protocol        String   @default("morpho")  // "morpho", "aave", "euler", "compound", "spark", etc.
  turtleId        String?  @unique             // Turtle opportunity ID for dedup
  dataSource      String   @default("morpho")  // Which pipeline owns this vault: "morpho" | "turtle"
  opportunityType String?                      // "lending" | "vault" from Turtle
  chainName       String?                      // Human-readable chain name ("Base", "Arbitrum", etc.)

  // Turtle-specific yield fields (APR, not APY)
  estTotalAPR     Float?                       // Turtle's reported "Est. Total APR" (percentage, e.g. 8.33)
  netAPR          Float?                       // estTotalAPR - performanceFee - managementFee
  aprBreakdown    Json?                        // Incentive sources from Turtle API

  // Deal mapping (Phase 3a): distributor opportunity this vault is depositable as.
  // Matched by turtleId, else receiptToken address+chain. Written by the
  // collect-turtle cron; dealCheckedAt stamps the last mapping change.
  dealOpportunityId String?   @unique
  dealDepositable   Boolean   @default(false)
  dealEstApr        Float?
  dealCheckedAt     DateTime?

  // Risk scoring (computed by update-vault-grades script)
  riskScore          Float?    // 0-100 composite risk score
  grade              String?   // "high-grade" | "other"
  sizeScore          Float?    // 0-25
  maturityScore      Float?    // 0-15
  curatorScore       Float?    // 0-35
  collateralScore    Float?    // 0-15
  riskIndicatorScore Float?    // 0-10
  gradeFailures     String[]  // Failure reasons from grade computation

  // Morpho governance warnings
  warnings           Json?                        // [{type, level}] from Morpho API
  listed             Boolean  @default(true)       // Morpho whitelisted status
  creationTimestamp  Int?                          // Unix timestamp from Morpho API
  pendingConfigs     Json?                         // Pending governance configs [{validAt, functionName, txHash}]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  snapshots            VaultSnapshot[]
  adapterAllocations   AdapterAllocation[]
  transactions         VaultTransaction[]
  reallocations        VaultReallocation[]
  riskSnapshots        VaultRiskSnapshot[]
  changes              VaultChange[]
  positions            VaultPosition[]
  marketAllocations    MarketAllocation[]
  depositRecords       DepositRecord[]
  platformAlerts       PlatformAlert[]

  @@index([chainId])
  @@index([assetSymbol])
  @@index([curatorId])
  @@index([curatorAddress])
  @@index([active])
  @@index([chainId, active])
  @@index([updatedAt])
  @@index([protocol])
  @@index([protocol, active])
  @@index([dataSource])
  @@index([grade])
  @@index([riskScore])
}

model VaultSnapshot {
  id             String   @id @default(cuid())
  vaultId        String
  vault          Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  totalAssets    String   // BigInt stored as string
  totalAssetsUsd Float
  totalSupply    String   // BigInt stored as string
  sharePrice     Float
  liquidity      String?  // Available liquidity in raw asset units
  liquidityUsd   Float?   // Available liquidity in USD
  apy            Float?
  netApy         Float?
  avgApy         Float?
  avgNetApy      Float?

  timestamp      DateTime @default(now())

  @@index([vaultId, timestamp])
  @@index([timestamp])
}

model AdapterAllocation {
  id              String   @id @default(cuid())
  vaultId         String
  vault           Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  adapterAddress  String
  adapterType     String
  assets          String   // BigInt stored as string
  assetsUsd       Float
  allocationPct   Float    // Percentage of vault TVL

  snapshotTime    DateTime @default(now())

  @@index([vaultId, snapshotTime])
  @@index([adapterAddress])
}

model VaultTransaction {
  id          String   @id @default(cuid())
  vaultId     String
  vault       Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  txHash      String
  blockNumber Int
  timestamp   DateTime
  type        String   // Deposit, Withdraw, Reallocate, Fee, etc.
  shares      String?  // Amount in shares
  assets      String?  // Amount in assets
  assetsUsd   Float?   // USD value at time of transaction

  createdAt   DateTime @default(now())

  @@unique([vaultId, txHash])
  @@index([vaultId, timestamp])
  @@index([txHash])
}

model VaultReallocation {
  id          String   @id @default(cuid())
  vaultId     String
  vault       Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  timestamp   DateTime
  txHash      String?
  type        String?  // Reallocate type (withdraw, supply, etc.)
  fromAdapter String?  // Adapter money moved FROM
  toAdapter   String?  // Adapter money moved TO
  marketId    String?  // Market unique key
  amount      String   // Amount reallocated
  amountUsd   Float?   // USD value

  createdAt   DateTime @default(now())

  @@index([vaultId, timestamp])
}

model VaultRiskSnapshot {
  id                  String   @id @default(cuid())
  vaultId             String
  vault               Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  timestamp           DateTime @default(now())

  // Concentration metrics
  topAdapterPercent   Float    // % in largest adapter
  top3AdaptersPercent Float    // % in top 3 adapters
  herfindahlIndex     Float    // Sum of squared percentages (0-10000)
  numActiveAdapters   Int

  // Liquidity metrics
  idleAssetsPercent   Float    // % sitting idle
  hasLiquidityAdapter Boolean  @default(false)

  // Diversification
  avgAllocationPercent Float   // Average % per adapter
  largestAllocation   Float    // Largest single allocation %

  // Overall scores (calculated)
  concentrationScore  String   // "low" | "medium" | "high"
  liquidityScore      String   // "low" | "medium" | "high"
  diversificationScore String  // "good" | "moderate" | "poor"

  createdAt           DateTime @default(now())

  @@index([vaultId, timestamp])
}

model VaultChange {
  id            String   @id @default(cuid())
  vaultId       String
  vault         Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  changeType    String   // TVL_CHANGE, APY_CHANGE, CONCENTRATION_RISK_CHANGE, etc.
  severity      String   // info, warning, critical
  title         String
  description   String

  oldValue      String?
  newValue      String?
  metadata      Json?    // Extra data like txHash, percentChange, etc.

  detectedAt    DateTime
  viewed        Boolean  @default(false)

  createdAt     DateTime @default(now())

  @@unique([vaultId, changeType, detectedAt])
  @@index([vaultId, detectedAt])
  @@index([severity, viewed])
  @@index([detectedAt])
}

model Curator {
  id              String   @id @default(cuid())
  address         String   @unique
  name            String?

  // Profile information
  website         String?
  twitter         String?
  discord         String?
  email           String?

  // Company/Entity info
  legalName       String?
  entityType      String?  // LLC, DAO, Corporation, Individual
  jurisdiction    String?  // US, Cayman Islands, Switzerland, etc.
  registeredState String?  // Delaware, Wyoming, etc.

  // Regulatory info
  isRegulated     Boolean  @default(false)
  regulatoryBody  String?  // SEC, FCA, FINMA, etc.
  licenses        Json?    // Array of license types

  // Location
  headquarters    String?  // City, Country

  // Metadata
  description     String?  @db.Text
  foundedYear     Int?
  teamSize        String?  // "1-10", "11-50", "51-200"

  // Social/Community
  logoUrl         String?

  // Computed stats (updated during data collection)
  totalAssetsManaged  Float?   @default(0)
  vaultCount          Int?     @default(0)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  vaults          Vault[]
  news            CuratorNews[]
  snapshots       CuratorSnapshot[]
  platformAlerts  PlatformAlert[]

  @@index([address])
  @@index([name])
  @@index([jurisdiction])
  @@index([totalAssetsManaged])
  @@index([vaultCount])
}

model CuratorNews {
  id          String   @id @default(cuid())
  curatorId   String
  curator     Curator  @relation(fields: [curatorId], references: [id], onDelete: Cascade)

  title       String
  summary     String?  @db.Text
  url         String
  source      String   // "Twitter", "Medium", "News Site", etc.
  publishedAt DateTime
  sentiment   String?  // "positive", "neutral", "negative"
  category    String?  // "announcement", "partnership", "audit", "incident"

  createdAt   DateTime @default(now())

  @@index([curatorId, publishedAt])
  @@index([publishedAt])
}

model CuratorSnapshot {
  id             String   @id @default(cuid())
  curatorId      String
  curator        Curator  @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  totalAssetsUsd Float
  vaultCount     Int
  timestamp      DateTime @default(now())

  @@index([curatorId, timestamp])
  @@index([timestamp])
}

model PlatformAlert {
  id          String   @id @default(cuid())
  scope       String   // "curator" | "ecosystem"
  curatorId   String?
  curator     Curator? @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  vaultId     String?  // Phase 3 (deferred 2d): vault drill-down for vault-scoped alerts
  vault       Vault?   @relation(fields: [vaultId], references: [id], onDelete: SetNull)
  changeType  String   // CURATOR_AUM_DROP, ECOSYSTEM_AUM_DROP, etc.
  severity    String   // info, warning, critical
  title       String
  description String
  oldValue    String?
  newValue    String?
  metadata    Json?
  detectedAt  DateTime
  viewed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([scope, curatorId, changeType, detectedAt])
  @@index([scope, detectedAt])
  @@index([curatorId, detectedAt])
  @@index([detectedAt])
  @@index([vaultId, detectedAt])
}

// Phase 3b: deposits attributed to CuratorWatch's distributor ID, synced from
// GET /v1/deposit/{distributorId} by the collect-turtle cron. The id is
// Turtle's stable deposit UUID (upsert key); vaultId resolves through the
// deal mapping and stays null for deals on untracked protocols.
model DepositRecord {
  id             String    @id
  opportunityId  String?
  vaultId        String?
  vault          Vault?    @relation(fields: [vaultId], references: [id], onDelete: SetNull)
  interaction    String    @default("deposit")
  txHash         String
  chainId        Int?
  walletAddress  String
  amountToken    String?
  amountInUsd    Float?
  tokenSymbol    String?
  blockTimestamp DateTime?
  createdAt      DateTime  @default(now())

  @@index([vaultId, blockTimestamp])
  @@index([opportunityId])
  @@index([walletAddress])
}

model VaultPosition {
  id          String   @id @default(cuid())
  vaultId     String
  vault       Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  userAddress String   // Depositor's address
  assets      String   // Amount in assets (BigInt as string)
  assetsUsd   Float    // USD value of position
  shares      String   // Amount in shares (BigInt as string)
  depositPct  Float    // % of total vault deposits

  // For tracking changes
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([vaultId, userAddress])
  @@index([vaultId, assetsUsd])
  @@index([userAddress])
  @@index([userAddress, assetsUsd])
}

model MarketAllocation {
  id              String   @id @default(cuid())
  vaultId         String
  vault           Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  marketUniqueKey String   // Morpho market unique key
  adapterAddress  String   // Adapter that connects to this market

  // Market info (cached from Morpho API)
  loanAssetSymbol       String
  loanAssetAddress      String
  collateralAssetSymbol String
  collateralAssetAddress String
  lltv                  Float    // Liquidation LTV (0-1 or 0-100)

  // Allocation
  supplyAssets    String   // Amount supplied
  supplyAssetsUsd Float
  allocationPct   Float    // % of vault TVL

  // Oracle info
  oracleAddress   String?
  oracleType      String?  // chainlink, morpho, uniswap, custom

  snapshotTime    DateTime @default(now())

  @@index([vaultId, snapshotTime])
  @@index([marketUniqueKey])
  @@index([collateralAssetSymbol])
}

model Liquidation {
  id                String   @id @default(cuid())
  txHash            String
  timestamp         DateTime
  marketUniqueKey   String
  borrower          String
  liquidator        String
  repaidAssetsUsd   Float
  seizedAssetsUsd   Float
  badDebtAssetsUsd  Float

  createdAt         DateTime @default(now())

  @@unique([txHash, marketUniqueKey, borrower])
  @@index([marketUniqueKey])
  @@index([timestamp])
}

model User {
  id              String           @id @default(cuid())
  clerkId         String           @unique
  email           String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  trackedVaults   TrackedVault[]
  trackedCurators TrackedCurator[]
}

model TrackedVault {
  id           String   @id @default(cuid())
  userId       String
  vaultAddress String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)

  @@unique([userId, vaultAddress])
  @@index([userId])
}

model TrackedCurator {
  id             String   @id @default(cuid())
  userId         String
  curatorAddress String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)

  @@unique([userId, curatorAddress])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Risk-engine ratings (external, loss-anchored Expected-Loss model).
// Denormalized read models populated by scripts/import-risk-engine-ratings.ts from
// the engine's versioned ratings JSON (engine runs offline; JSON is the contract).
// Standalone tables (no FK to Curator/Vault) so the import never blocks on identity
// resolution and the existing on-the-fly 7-factor system is untouched. Every row is
// traceable to the model that produced it (methodologyVersion/schemaVersion/modelGit).
// ─────────────────────────────────────────────────────────────────────────────
model CuratorRating {
  id                 String   @id @default(cuid())
  curatorAddress     String   @unique   // site-curator address this rating joins to (lowercased)
  curatorKey         String              // engine curator id, e.g. "steakhouse-financial"
  name               String?
  grade              String              // A+ | A | B+ | B | C+ | C | D | E | NR
  elMedian           Float               // expected loss, annualized fraction
  elCiLow            Float               // 90% credible interval
  elCiHigh           Float
  pLossAnnual        Float?
  lgdMedian          Float?
  channels           Json                // {credit, technical, operational} shares
  confidence         String              // Tight | Moderate | Wide
  flags              Json                // {repeat_offender, diligence_conflict, declined_credit, ...}
  nVaults            Int?
  tvlUsd             Float?
  exposureMonths     Int?
  events             Int?
  addresses          Json                // all engine addresses [{address, chainId}]
  methodologyVersion String
  schemaVersion      String
  modelGit           String?
  generatedAt        DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([curatorAddress])
  @@index([grade])
}

model VaultRating {
  id                 String   @id @default(cuid())
  vaultKey           String   @unique   // "<chainId>:<address>" from the engine
  chainId            Int
  vaultAddress       String
  curatorKey         String?
  grade              String
  elMedian           Float
  elCiLow            Float
  elCiHigh           Float
  pdAnnualMedian     Float?
  lgdMedian          Float?
  schemaVersion      String
  modelGit           String?
  generatedAt        DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([vaultAddress])
  @@index([chainId, vaultAddress])
}
